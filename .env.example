# Copy to .env and fill in the values.

# Required: token from @BotFather
BOT_TOKEN=

# Optional: chat id that receives a notification for every lead
# (send your bot a message, then open https://api.telegram.org/bot<TOKEN>/getUpdates)
ADMIN_CHAT_ID=

# Optional: Google Apps Script web app URL (see google-apps-script.js).
# Without it, leads are stored in leads.jsonl next to bot.js.
SHEETS_WEBHOOK_URL=

# Optional: shared secret that the Apps Script checks
SHEETS_TOKEN=
